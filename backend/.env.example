# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key (Settings -> API -> service_role secret)
# NOT the anon/public key. This key bypasses Row Level Security,
# which is why it must stay on the backend and NEVER be sent to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port the Express server listens on
PORT=5000

# Set this once your frontend is deployed (e.g. https://your-app.vercel.app)
# Leave blank while developing locally.
FRONTEND_URL=
